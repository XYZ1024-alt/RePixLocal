{
  "name": "repix-local",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "fetch-tools": "powershell -ExecutionPolicy Bypass -File scripts/fetch-tools.ps1",
    "build": "npm run fetch-tools && tauri build",
    "build:win": "npm run fetch-tools && tauri build --target x86_64-pc-windows-msvc",
    "ui:dev": "vite --host 127.0.0.1",
    "ui:build": "vite build",
    "ui:check": "tsc --noEmit",
    "rust:check": "npm run fetch-tools && cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:test": "npm run fetch-tools && cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run ui:check && npm run rust:test",
    "check": "npm run ui:check && npm run rust:check && npm run rust:test"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
