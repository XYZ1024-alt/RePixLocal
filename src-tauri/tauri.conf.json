{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RePix Local",
  "version": "0.1.0",
  "identifier": "local.repix.desktop",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RePix Local",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$DATA/RePix/RePixLocal/data/**/*",
            "$DATA/local/RePix/RePixLocal/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/whisper-cli"
    ],
    "resources": {
      "binaries/whisper-runtime/": "whisper-runtime/"
    },
    "icon": ["icons/icon.ico"],
    "shortDescription": "Local AI video replication desktop app",
    "longDescription": "RePix Local runs the full five-stage AI video replication pipeline on your machine: transcription, script rewrite, storyboard generation, segment synthesis, and final render.",
    "copyright": "Copyright © RePix. All rights reserved.",
    "category": "Video",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
